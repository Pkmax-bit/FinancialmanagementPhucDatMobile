<?xml version="1.0" encoding="utf-8"?>
<android.widget.RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/bg_rounded_gray">

    <TextView
        android:id="@+id/text_checklist_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Checklist Title"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/task_priority_medium"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true" />

    <ImageView
        android:id="@+id/image_checklist_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/gray_600"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true" />

    <ImageButton
        android:id="@+id/btn_add_checklist_item"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_add"
        android:background="@drawable/bg_circle_primary"
        android:tint="@android:color/white"
        android:layout_toStartOf="@id/image_checklist_arrow"
        android:layout_centerVertical="true"
        android:layout_marginEnd="12dp"
        android:scaleType="centerInside" />

</android.widget.RelativeLayout>
