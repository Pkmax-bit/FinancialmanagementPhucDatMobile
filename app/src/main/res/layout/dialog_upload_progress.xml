<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/text_upload_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đang tải lên file..."
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/text_upload_filename"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="filename.jpg"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:ellipsize="middle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ProgressBar
            android:id="@+id/progress_upload"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/text_progress_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="14sp"
            android:layout_marginStart="12dp"
            android:minWidth="40dp"
            android:gravity="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_upload_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 / 5 file"
        android:textSize="12sp"
        android:textColor="#666666" />

    <Button
        android:id="@+id/btn_cancel_upload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hủy"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        style="@style/Widget.AppCompat.Button.Borderless" />

</LinearLayout>

