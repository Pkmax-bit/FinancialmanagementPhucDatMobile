<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_input_field_modern"
    android:padding="16dp">

    <!-- Title and Status Row -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkbox_subtask_completed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:minWidth="40dp"
        android:minHeight="40dp"
        android:padding="4dp"
        app:buttonTint="@color/primary_color"
        app:useMaterialThemeColors="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/text_subtask_title" />

    <TextView
        android:id="@+id/text_subtask_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:fontFamily="sans-serif-medium"
        android:text="Tên nhiệm vụ con"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/text_subtask_status"
        app:layout_constraintStart_toEndOf="@+id/checkbox_subtask_completed"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_subtask_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone">
        
        <ImageButton
            android:id="@+id/btn_edit_subtask"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_edit"
            android:background="@drawable/bg_circle_primary"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:layout_marginEnd="4dp" />
        
        <ImageButton
            android:id="@+id/btn_delete_subtask"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="@drawable/bg_circle_primary"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:tint="@android:color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_subtask_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_rounded"
        android:backgroundTint="@color/task_status_todo_bg"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="Cần làm"
        android:textColor="@color/task_status_todo_text"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/layout_subtask_actions"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Divider or Spacing -->
    
    <!-- Assignments Row (Multiple) -->
    <LinearLayout
        android:id="@+id/layout_subtask_assignments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/text_subtask_title">
        <!-- Assignment items will be added here -->
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout_assignee_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/layout_subtask_assignments">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_subtask_assignee_initials"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="@color/primary_color"
                android:gravity="center"
                android:text="A"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subtask_assignee_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Nguyễn Văn B"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_subtask_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="@color/primary_color"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Image Thumbnails Container (for images only) -->
    <HorizontalScrollView
        android:id="@+id/scrollview_subtask_images"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout_assignee_row">
        
        <LinearLayout
            android:id="@+id/layout_subtask_image_thumbnails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingEnd="8dp">
            <!-- Image thumbnails will be added here -->
        </LinearLayout>
    </HorizontalScrollView>

    <!-- File Attachments Container -->
    <LinearLayout
        android:id="@+id/layout_subtask_files"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/scrollview_subtask_images"
        tools:visibility="visible">
        <!-- Files will be added dynamically here -->
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
