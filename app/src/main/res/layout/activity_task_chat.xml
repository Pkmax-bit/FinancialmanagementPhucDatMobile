<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0f2f5">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Trao đổi"
            app:titleTextColor="@color/black" />
        
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:clipToPadding="false" />
        
        <!-- Typing Indicator -->
        <TextView
            android:id="@+id/text_typing_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:paddingStart="16dp"
            android:text="Đang soạn tin nhắn..."
            android:textSize="12sp"
            android:textColor="#666666"
            android:textStyle="italic"
            android:visibility="gone"
            android:background="@android:color/white" />

        <!-- Input Area Zalo Style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="vertical"
            android:elevation="8dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />

            <!-- Preview selected files/images -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_selected_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone"
                android:clipToPadding="false" />
            
            <!-- Reply Preview -->
            <LinearLayout
                android:id="@+id/layout_reply_preview_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:background="#F0F2F5"
                android:padding="12dp"
                android:gravity="center_vertical">
                
                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/task_accent"
                    android:layout_marginEnd="12dp" />
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/text_reply_sender_input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Người gửi"
                        android:textColor="@color/task_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    
                    <TextView
                        android:id="@+id/text_reply_content_input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nội dung tin nhắn"
                        android:textColor="#80000000"
                        android:textSize="12sp"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>
                
                <ImageButton
                    android:id="@+id/btn_cancel_reply"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    app:tint="#65676B" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageButton
                    android:id="@+id/btn_attach_file"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_attachment"
                    app:tint="#65676B" />
                
                <ImageButton
                    android:id="@+id/btn_emoji"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_emoji"
                    app:tint="#65676B" />
                
                <ImageButton
                    android:id="@+id/btn_voice"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_btn_speak_now"
                    app:tint="#65676B" />

                <EditText
                    android:id="@+id/edit_chat_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_search_box"
                    android:hint="Nhập tin nhắn..."
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:textSize="15sp"
                    android:maxLines="5"
                    android:textColor="@color/black"
                    android:textColorHint="#8E8E93" />

                <ImageButton
                    android:id="@+id/btn_send_message"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_send"
                    app:tint="@color/task_accent" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
