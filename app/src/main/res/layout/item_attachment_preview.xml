<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="80dp"
    android:layout_height="80dp"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Image Preview for Images -->
        <ImageView
            android:id="@+id/image_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- File Icon for Documents -->
        <LinearLayout
            android:id="@+id/layout_file_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/image_file_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_attachment"
                android:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/text_file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="file.pdf"
                android:textColor="@color/text_primary"
                android:textSize="9sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_file_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PDF"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Upload Progress Overlay -->
        <LinearLayout
            android:id="@+id/layout_upload_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/upload_overlay_bg"
            android:visibility="gone">

            <!-- Progress Indicator -->
            <ProgressBar
                android:id="@+id/progress_upload"
                style="?android:attr/progressBarStyle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Status Icons -->
            <ImageView
                android:id="@+id/image_upload_status"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check_circle"
                android:tint="@color/task_success"
                android:visibility="gone" />

            <!-- Error Icon -->
            <ImageView
                android:id="@+id/image_upload_error"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_error"
                android:tint="@color/task_error"
                android:visibility="gone" />

            <!-- Upload Progress Text -->
            <TextView
                android:id="@+id/text_upload_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Remove Button -->
        <ImageButton
            android:id="@+id/btn_remove_attachment"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_circle_white"
            android:tint="@color/text_primary"
            android:scaleType="centerInside" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
